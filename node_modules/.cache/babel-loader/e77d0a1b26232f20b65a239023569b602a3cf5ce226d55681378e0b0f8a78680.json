{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport ProductCard from '../components/ProductCard.vue';\nexport default {\n  components: {\n    ProductCard\n  },\n  data() {\n    return {\n      products: [],\n      searchQuery: '',\n      valid: true\n    };\n  },\n  computed: {\n    groupedByCategory() {\n      const groups = {};\n      this.searchProducts.forEach(prod => {\n        const cat = prod.category;\n        if (!groups[cat]) groups[cat] = [];\n        groups[cat].push(prod);\n      });\n      return groups;\n    },\n    searchProducts() {\n      if (!this.searchQuery) return this.products;\n      const query = this.searchQuery.toLowerCase();\n      return this.products.filter(prod => prod.title.toLowerCase().includes(query));\n    }\n  },\n  methods: {\n    async getProducts() {\n      await fetch('https://dummyjson.com/products').then(res => res.json()).then(data => this.products = data.products);\n    }\n  },\n  async mounted() {\n    await this.getProducts();\n  }\n};","map":{"version":3,"names":["ProductCard","components","data","products","searchQuery","valid","computed","groupedByCategory","groups","searchProducts","forEach","prod","cat","category","push","query","toLowerCase","filter","title","includes","methods","getProducts","fetch","then","res","json","mounted"],"sources":["/home/doha/Public/vue_study/product_app/src/views/ProdctsPage.vue"],"sourcesContent":["<template>\n    <v-container>\n        <v-form v-model=\"valid\">\n            <v-container>\n                <v-row>\n                    <v-col cols=\"12\" md=\"12\">\n                        <v-text-field v-model=\"searchQuery\" label=\"search and filter products...\" clearable\n                            required></v-text-field>\n                    </v-col>\n                </v-row>\n            </v-container>\n        </v-form>\n    </v-container>\n    <v-container class=\"text-center\">\n        <div v-for=\"(items, category) in groupedByCategory\" :key=\"category\" class=\"category-group pb-9\">\n            <h4 class=\"title mb-4 capitalize-text\">{{ category }} Groups ⚡</h4>\n            <v-row density=\"comfortable\">\n                <v-col v-for=\"prod in items\" :key=\"prod.id\" cols=\"12\" md=\"4\">\n                    <ProductCard :product=\"prod\" />\n                </v-col>\n            </v-row>\n            <v-divider :thickness=\"2\" class=\"border-opacity-25 mt-9\" color=\"success\"></v-divider>\n        </div>\n\n    </v-container>\n    <v-container>\n         <v-alert v-if=\"Object.keys(groupedByCategory).length === 0\"\n            text=\"No products found\"\n            type=\"error\"\n        ></v-alert>\n    </v-container>\n</template>\n\n<style lang=\"scss\">\n.title {\n    position: relative;\n    font-size: 32px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 36px;\n    width: max-content;\n    padding-inline-start: 16px;\n\n    &::before {\n        content: '';\n        position: absolute;\n        display: block;\n        width: 3px;\n        height: calc(100% - 0px);\n        background-color: #4CAF50;\n        border-radius: 25px;\n        inset-inline-start: 0;\n    }\n}\n\n.v-card {\n    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.1);\n}\n\n.prodct__card {\n    &--title {\n        font-size: 24px;\n        font-weight: 600;\n    }\n}\n\n.capitalize-text {\n    text-transform: capitalize;\n}\n\n.ellipsed {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n</style>\n<script>\nimport ProductCard from '../components/ProductCard.vue';\nexport default {\n    components: {\n        ProductCard\n    },\n    data() {\n        return {\n            products: [],\n            searchQuery: '',\n            valid: true \n        }\n    },\n    computed: {\n       \n\n        groupedByCategory() {\n            const groups = {};\n            this.searchProducts.forEach(prod => {\n                const cat = prod.category;\n                if (!groups[cat]) groups[cat] = [];\n                groups[cat].push(prod);\n            });\n            return groups;\n        },\n         searchProducts() {\n            if (!this.searchQuery) return this.products;\n            const query = this.searchQuery.toLowerCase();\n            return this.products.filter(prod =>\n                prod.title.toLowerCase().includes(query)\n            );\n        },\n    },\n    methods: {\n        async getProducts() {\n            await fetch('https://dummyjson.com/products')\n                .then((res) => res.json())\n                .then((data) => (this.products = data.products))\n        }\n    },\n    async mounted() {\n        await this.getProducts()\n    }\n}\n</script>"],"mappings":";;;;AA6EA,OAAOA,WAAU,MAAO,+BAA+B;AACvD,eAAe;EACXC,UAAU,EAAE;IACRD;EACJ,CAAC;EACDE,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,QAAQ,EAAE,EAAE;MACZC,WAAW,EAAE,EAAE;MACfC,KAAK,EAAE;IACX;EACJ,CAAC;EACDC,QAAQ,EAAE;IAGNC,iBAAiBA,CAAA,EAAG;MAChB,MAAMC,MAAK,GAAI,CAAC,CAAC;MACjB,IAAI,CAACC,cAAc,CAACC,OAAO,CAACC,IAAG,IAAK;QAChC,MAAMC,GAAE,GAAID,IAAI,CAACE,QAAQ;QACzB,IAAI,CAACL,MAAM,CAACI,GAAG,CAAC,EAAEJ,MAAM,CAACI,GAAG,IAAI,EAAE;QAClCJ,MAAM,CAACI,GAAG,CAAC,CAACE,IAAI,CAACH,IAAI,CAAC;MAC1B,CAAC,CAAC;MACF,OAAOH,MAAM;IACjB,CAAC;IACAC,cAAcA,CAAA,EAAG;MACd,IAAI,CAAC,IAAI,CAACL,WAAW,EAAE,OAAO,IAAI,CAACD,QAAQ;MAC3C,MAAMY,KAAI,GAAI,IAAI,CAACX,WAAW,CAACY,WAAW,CAAC,CAAC;MAC5C,OAAO,IAAI,CAACb,QAAQ,CAACc,MAAM,CAACN,IAAG,IAC3BA,IAAI,CAACO,KAAK,CAACF,WAAW,CAAC,CAAC,CAACG,QAAQ,CAACJ,KAAK,CAC3C,CAAC;IACL;EACJ,CAAC;EACDK,OAAO,EAAE;IACL,MAAMC,WAAWA,CAAA,EAAG;MAChB,MAAMC,KAAK,CAAC,gCAAgC,EACvCC,IAAI,CAAEC,GAAG,IAAKA,GAAG,CAACC,IAAI,CAAC,CAAC,EACxBF,IAAI,CAAErB,IAAI,IAAM,IAAI,CAACC,QAAO,GAAID,IAAI,CAACC,QAAS;IACvD;EACJ,CAAC;EACD,MAAMuB,OAAOA,CAAA,EAAG;IACZ,MAAM,IAAI,CAACL,WAAW,CAAC;EAC3B;AACJ","ignoreList":[]},"metadata":{},"sourceTyp