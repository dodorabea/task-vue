{"ast":null,"code":"import { reactive } from 'vue';\nimport { useVuelidate } from '@vuelidate/core';\nimport { email, required } from '@vuelidate/validators';\nexport default {\n  __name: 'Login',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const initialState = {\n      name: '',\n      email: ''\n    };\n    const state = reactive({\n      ...initialState\n    });\n    const rules = {\n      name: {\n        required\n      },\n      email: {\n        required,\n        email\n      }\n    };\n    const v$ = useVuelidate(rules, state);\n    function clear() {\n      v$.value.$reset();\n      for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value;\n      }\n    }\n    const __returned__ = {\n      initialState,\n      state,\n      rules,\n      v$,\n      clear,\n      reactive,\n      get useVuelidate() {\n        return useVuelidate;\n      },\n      get email() {\n        return email;\n      },\n      get required() {\n        return required;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","useVuelidate","email","required","initialState","name","state","rules","v$","clear","value","$reset","key","Object","entries"],"sources":["/home/doha/Public/vue_study/product_app/src/views/Login.vue"],"sourcesContent":["<template>\n    <div class=\"login__layout\">\n        <v-container>\n            <v-row justify=\"center\">\n                <v-col cols=\"12\" md=\"6\">\n                    <v-card>\n                        <div class=\"login__layout--title mb-6 text-center\">\n                            <h1>Welcome Back</h1>\n                            <p>Let’s get you back to shopping and exploring.</p>\n                        </div>\n                        <form>\n                            <v-text-field v-model=\"state.name\" :counter=\"10\"\n                                :error-messages=\"v$.name.$errors.map(e => e.$message)\" label=\"Name\" required\n                                @blur=\"v$.name.$touch\" @input=\"v$.name.$touch\"></v-text-field>\n\n                            <v-text-field v-model=\"state.email\" :error-messages=\"v$.email.$errors.map(e => e.$message)\"\n                                label=\"E-mail\" required @blur=\"v$.email.$touch\" @input=\"v$.email.$touch\"></v-text-field>\n\n                            <v-btn class=\"me-4\" @click=\"v$.$validate\">\n                                submit\n                            </v-btn>\n                            <v-btn @click=\"clear\">\n                                clear\n                            </v-btn>\n                        </form>\n                    </v-card>\n                </v-col>\n            </v-row>\n        </v-container>\n    </div>\n</template>\n\n<script setup>\nimport { reactive } from 'vue'\nimport { useVuelidate } from '@vuelidate/core'\nimport { email, required } from '@vuelidate/validators'\n\nconst initialState = {\n    name: '',\n    email: '',\n}\n\nconst state = reactive({\n    ...initialState,\n})\n\nconst rules = {\n    name: { required },\n    email: { required, email },\n}\n\nconst v$ = useVuelidate(rules, state)\n\nfunction clear() {\n    v$.value.$reset()\n\n    for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value\n    }\n}\n</script>\n<style lang=\"scss\" scoped>\nbody {\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n\n    .login__layout {\n        &--title {\n            h1 {\n                font-size: 24px;\n                font-weight: 600;\n                color: #053E4B;\n            }\n\n            p {\n                font-size: 18px;\n                color: #6B6B6B;\n                font-weight: 300;\n            }\n        }\n    }\n}\n</style>"],"mappings":"AAiCA,SAASA,QAAQ,QAAQ,KAAI;AAC7B,SAASC,YAAY,QAAQ,iBAAgB;AAC7C,SAASC