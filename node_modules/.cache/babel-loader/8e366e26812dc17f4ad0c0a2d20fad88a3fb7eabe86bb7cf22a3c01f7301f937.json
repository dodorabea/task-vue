{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { reactive } from 'vue';\nimport { useVuelidate } from '@vuelidate/core';\nimport { email, required } from '@vuelidate/validators';\nimport { useRouter } from 'vue-router';\nexport default {\n  __name: 'Login',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const initialState = {\n      name: '',\n      email: ''\n    };\n    const state = reactive({\n      ...initialState\n    });\n    const rules = {\n      name: {\n        required\n      },\n      email: {\n        required,\n        email\n      }\n    };\n    const router = useRouter();\n    async function handleSubmit() {\n      const isValid = await v$.value.$validate();\n      if (!isValid) {\n        console.log('Validation failed');\n        return;\n      }\n      router.push({\n        name: 'products'\n      });\n    }\n    const v$ = useVuelidate(rules, state);\n    function clear() {\n      v$.value.$reset();\n      for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value;\n      }\n    }\n    const __returned__ = {\n      initialState,\n      state,\n      rules,\n      router,\n      handleSubmit,\n      v$,\n      clear,\n      reactive,\n      get useVuelidate() {\n        return useVuelidate;\n      },\n      get email() {\n        return email;\n      },\n      get required() {\n        return required;\n      },\n      get useRouter() {\n        return useRouter;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","useVuelidate","email","required","useRouter","initialState","name","state","rules","router","handleSubmit","isValid","v$","value","$validate","console","log","push","clear","$reset","key","Object","entries"],"sources":["/home/doha/Public/vue_study/product_app/src/views/Login.vue"],"sourcesContent":["<template>\n    <div class=\"login__layout\">\n        <v-container>\n            <v-row justify=\"center\">\n                <v-col cols=\"12\" md=\"6\">\n                    <v-card class=\"pa-5\" rounded=\"xl\">\n                        <v-card-text class=\"login__layout--title text-center\">\n                            <h1>Welcome Back</h1>\n                            <p>Let’s get you back to shopping and exploring.</p>\n                        </v-card-text>\n                       \n                        <form class=\"d-flex flex-column ga-4\" @submit.prevent=\"handleSubmit\">\n                            <v-text-field v-model=\"state.name\" :counter=\"10\"\n                                :error-messages=\"v$.name.$errors.map(e => e.$message)\" label=\"Name\" required\n                                @blur=\"v$.name.$touch\" @input=\"v$.name.$touch\" class=\"rounded-pill\"></v-text-field>\n\n                            <v-text-field  v-model=\"state.email\" :error-messages=\"v$.email.$errors.map(e => e.$message)\"\n                                label=\"E-mail\" required @blur=\"v$.email.$touch\" @input=\"v$.email.$touch\"></v-text-field>\n\n                            <div class=\"d-flex ga-3\">\n                                <v-btn  variant=\"outlined\" color=\"success\">\n                                    submit\n                                </v-btn>\n                                <v-btn @click=\"clear\" variant=\"elevated\" color=\"primary\">\n                                    clear\n                                </v-btn>\n                            </div>\n                        </form>\n                    </v-card>\n                </v-col>\n            </v-row>\n        </v-container>\n    </div>\n</template>\n\n<script setup>\nimport { reactive } from 'vue'\nimport { useVuelidate } from '@vuelidate/core'\nimport { email, required } from '@vuelidate/validators'\nimport { useRouter } from 'vue-router'\nconst initialState = {\n    name: 