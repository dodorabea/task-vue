te;\n        display: block;\n        width: 3px;\n        height: calc(100% - 0px);\n        background-color: #4CAF50;\n        border-radius: 25px;\n        inset-inline-start: 0;\n    }\n}\n\n.v-card {\n    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.1);\n}\n\n.prodct__card {\n    &--title {\n        font-size: 24px;\n        font-weight: 600;\n    }\n}\n\n.capitalize-text {\n    text-transform: capitalize;\n}\n\n.ellipsed {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n</style>\n<script>\nimport ProductCard from '../components/ProductCard.vue';\nexport default {\n    components: {\n        ProductCard\n    },\n    data() {\n        return {\n            products: [],\n        }\n    },\n    computed: {\n        groupedByCategory() {\n            const groups = {};\n            this.products.forEach(prod => {\n                const cat = prod.category;\n                if (!groups[cat]) groups[cat] = [];\n                groups[cat].push(prod);\n            });\n            return groups;\n        }\n    },\n    methods: {\n        async getProducts() {\n            await fetch('https://dummyjson.com/products')\n                .then((res) => res.json())\n                .then((data) => (this.products = data.products))\n        }\n    },\n    async mounted() {\n        await this.getProducts()\n    }\n}\n</script>"],"mappings":";;;AA2DA,OAAOA,WAAU,MAAO,+BAA+B;AACvD,eAAe;EACXC,UAAU,EAAE;IACRD;EACJ,CAAC;EACDE,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,QAAQ,EAAE;IACNC,iBAAiBA,CAAA,EAAG;MAChB,MAAMC,MAAK,GAAI,CAAC,CAAC;MACjB,IAAI,CAACH,QAAQ,CAACI,OAAO,CAACC,IAAG,IAAK;QAC1B,MAAMC,GAAE,GAAID,IAAI,CAACE,QAAQ;QACzB,IAAI,CAACJ,MAAM,CAACG,GAAG,CAAC,EAAEH,MAAM,CAACG,GAAG,IAAI,EAAE;QAClCH,MAAM,CAACG,GAAG,CAAC,CAACE,IAAI,CAACH,IAAI,CAAC;MAC1B,CAAC,CAAC;MACF,OAAOF,MAAM;IACjB;EACJ,CAAC;EACDM,OAAO,EAAE;IACL,MAAMC,WAAWA,CAAA,EAAG;MAChB,MAAMC,KAAK,CAAC,gCAAgC,EACvCC,IAAI,CAAEC,GAAG,IAAKA,GAAG,CAACC,IAAI,CAAC,CAAC,EACxBF,IAAI,CAA