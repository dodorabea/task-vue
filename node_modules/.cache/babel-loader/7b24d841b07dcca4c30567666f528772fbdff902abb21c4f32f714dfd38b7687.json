{"ast":null,"code":"export default {\n  data() {\n    return {\n      product: null\n    };\n  },\n  async mounted() {\n    const productId = this.$route.params.id;\n    const res = await fetch('https://dummyjson.com/products/' + productId);\n    const data = await res.json();\n    this.product = data;\n  }\n};","map":{"version":3,"names":["data","product","mounted","productId","$route","params","id","res","fetch","json"],"sources":["/home/doha/Public/vue_study/product_app/src/views/ProductPageDetails.vue"],"sourcesContent":["<template>\n    <v-container>\n    <v-btn variant=\"text\"> <v-icon color=\"success\">mdi-arrow-left-circle</v-icon> Back</v-btn>\n    </v-container>\n    <v-container class=\"text-center\" v-if=\"product\">\n        <v-row density=\"comfortable\">\n            <v-col cols=\"12\" md=\"4\" class=\"mx-auto\">\n                <h4 class=\"title mb-4 capitalize-text\">{{ product.category }} Groups ⚡</h4>\n            </v-col>\n            <v-col cols=\"12\" md=\"8\" class=\"mx-auto\">\n                <v-card class=\"prodct__card mx-auto pa-4\" outlined  rounded=\"lg\">\n                    <v-row align=\"center\" justify=\"center\">\n                        <v-col cols=\"12\" md=\"4\">\n                            <v-img :src=\"product.thumbnail\"/>\n                        </v-col>\n                        <v-col cols=\"12\" md=\"8\">\n                            <v-card-text class=\"text-start\">\n                                <div class=\"prodct__card--title ellipsed\">{{ product.title }}</div>\n                                <span class=\"prodct__card--price\"><span>price:</span> ${{ product.price.toFixed(2) }}</span>\n                                <div class=\"rating\">\n                                    <v-icon v-for=\"star in 4\" color=\"warning\">mdi-star</v-icon>\n                                    <span>({{ product.rating }})</span>\n                                </div>\n                            </v-card-text>\n                        </v-col>\n                    </v-row>\n                </v-card>\n            </v-col>\n        </v-row>\n    </v-container>\n    <v-container v-else>\n        <div>Product not found</div>\n    </v-container>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      product: null,\n    }\n  },\n  async mounted() {\n    const productId = this.$route.params.id;\n    const res = await fetch('https://dummyjson.com/products/' + productId);\n    const data = await res.json();\n    this.product = data;\n  }\n}\n</script>\n<style lang=\"scss\">\n.title {\n    position: relative;\n    font-size: 32px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 36px;\n    width: max-content;\n    padding-inline-start: 16px;\n\n    &::before {\n        content: '';\n        position: absolute;\n        display: block;\n        width: 3px;\n        height: calc(100% - 0px);\n        background-color: #4CAF50;\n        border-radius: 25px;\n        inset-inline-start: 0;\n    }\n}\n.v-card-text{\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n.v-card {\n    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.1);\n}\n\n.prodct__card {\n    &--title {\n        font-size: 24px;\n        font-weight: 600;\n    }\n    &--price{\n        span{\n            color: #27AE60;\n            font-weight: 700;\n        }\n    }\n}\n\n.capitalize-text {\n    text-transform: capitalize;\n}\n.rating{\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    span{\n        padding-inline-start: 8px;\n        color: #898990;\n    }\n}\n.ellipsed {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\nbutton{\n    &.v-btn{\n        padding: 0;\n    }\n}\n</style>"],"mappings":"AAmCA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;IACX;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAMC,SAAQ,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACC,EAAE;IACvC,MAAMC,GAAE,GAAI,MAAMC,KAAK,CAAC,iCAAgC,GAAIL,SAAS,CAAC;IACtE,MAAMH,IAAG,GAAI,MAAMO,GAAG,CAACE,IAAI,CAAC,CAAC;IAC7B,IAAI,CAACR,OAAM,GAAID,IAAI;EACrB;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}