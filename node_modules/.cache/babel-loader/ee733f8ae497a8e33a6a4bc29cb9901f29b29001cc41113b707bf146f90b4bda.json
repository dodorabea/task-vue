{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nexport default {\n  __name: 'register',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n\n    //Use Composition Api\n    const router = useRouter();\n    const state = ref({\n      firstName: '',\n      lastName: '',\n      username: '',\n      email: '',\n      password: ''\n    });\n    const visible = ref(false);\n    const registerError = ref('');\n    const successMessage = ref('');\n    const loginError = ref('');\n    const initialState = {\n      username: '',\n      password: ''\n    };\n    const v$ = useVuelidate(rules, state);\n    function clear() {\n      v$.value.$reset();\n      for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value;\n        loginError.value = '';\n      }\n    }\n    async function handleRegister() {\n      registerError.value = '';\n      successMessage.value = '';\n      try {\n        const res = await fetch('https://dummyjson.com/users/add', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify(state)\n        });\n        const data = await res.json();\n        if (res.ok) {\n          successMessage.value = 'User registered successfully! Redirecting to login...';\n          setTimeout(() => router.push('/login'), 2000);\n        } else {\n          registerError.value = data.message || 'Registration failed!';\n        }\n      } catch (err) {\n        registerError.value = 'Something went wrong.';\n        console.error(err);\n      }\n    }\n    const __returned__ = {\n      router,\n      state,\n      visible,\n      registerError,\n      successMessage,\n      loginError,\n      initialState,\n      v$,\n      clear,\n      handleRegister,\n      ref,\n      get useRouter() {\n        return useRouter;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","useRouter","router","state","firstName","lastName","username","email","password","visible","registerError","successMessage","loginError","initialState","v$","useVuelidate","rules","clear","value","$reset","key","Object","entries","handleRegister","res","fetch","method","headers","body","JSON","stringify","data","json","ok","setTimeout","push","message","err","console","error"],"sources":["/home/doha/Public/vue_study/product_app/src/views/register.vue"],"sourcesContent":["<template>\n    <div class=\"login__layout\">\n        <v-container>\n            <v-row justify=\"center\">\n                <v-col cols=\"12\" md=\"6\">\n                    <v-card class=\"pa-5\" rounded=\"xl\">\n                        <v-card-text class=\"login__layout--title text-center\">\n                            <h1>Welcome Back</h1>\n                            <p>Let’s get you back to shopping and exploring.</p>\n                        </v-card-text>\n\n                        <form class=\"d-flex flex-column ga-4\" @submit.prevent=\"handleRegister\">\n                            <!--First name-->\n                            <v-text-field v-model=\"state.firstName\"\n                                :error-messages=\"v$.firstName.$errors.map(e => e.$message)\" label=\"First Name\" required\n                                @blur=\"v$.firstName.$touch\" @input=\"v$.firstName.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n                            <!--Last Name-->\n                            <v-text-field v-model=\"state.lastName\"\n                                :error-messages=\"v$.lastName.$errors.map(e => e.$message)\" label=\"Last Name\" required\n                                @blur=\"v$.lastName.$touch\" @input=\"v$.lastName.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n                            <!--User Name-->\n                            <v-text-field v-model=\"state.username\"\n                                :error-messages=\"v$.username.$errors.map(e => e.$message)\" label=\"User Name\" required\n                                @blur=\"v$.username.$touch\" @input=\"v$.username.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n                            <!--Email-->\n                            <v-text-field v-model=\"state.email\"\n                                :error-messages=\"v$.email.$errors.map(e => e.$message)\" label=\"Email\" required\n                                @blur=\"v$.email.$touch\" @input=\"v$.email.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n                            <!--Password -->\n                            <v-text-field v-model=\"state.password\"\n                                :error-messages=\"v$.password.$errors.map(e => e.$message)\" label=\"Password\" required\n                                @blur=\"v$.password.$touch\" @input=\"v$.password.$touch\"\n                                :append-inner-icon=\"visible ? 'mdi-eye-off' : 'mdi-eye'\"\n                                :type=\"visible ? 'text' : 'password'\" @click:append-inner=\"visible = !visible\"\n                                class=\"rounded-pill\"></v-text-field>\n\n                            <div class=\"d-flex flex-wrap ga-3\">\n                                <v-btn @click=\"v$.$validate\" variant=\"outlined\" color=\"success\" type=\"submit\">\n                                    submit\n                                </v-btn>\n                                <v-btn @click=\"clear\" variant=\"elevated\" color=\"primary\">\n                                    clear\n                                </v-btn>\n                            </div>\n                            <div v-if=\"loginError\" class=\"login__error text-center mb-3\">\n                                <v-alert type=\"error\" variant=\"outlined\">\n                                    {{ loginError }}\n                                </v-alert>\n                            </div>\n                        </form>\n\n                    </v-card>\n                </v-col>\n            </v-row>\n        </v-container>\n    </div>\n</template>\n\n<script setup>\n//Use Composition Api\nimport { ref } from 'vue'\nimport { useRouter } from 'vue-router'\n\nconst router = useRouter()\nconst state = ref({\n    firstName: '',\n    lastName: '',\n    username: '',\n    email: '',\n    password: ''\n})\nconst visible = ref(false)\nconst registerError = ref('')\nconst successMessage = ref('')\n\n\nconst loginError = ref('')\nconst initialState = {\n    username: '',\n    password: '',\n}\nconst v$ = useVuelidate(rules, state)\n\nfunction clear() {\n    v$.value.$reset()\n\n    for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value\n        loginError.value = ''\n    }\n}\nasync function handleRegister() {\n    registerError.value = ''\n    successMessage.value = ''\n\n    try {\n        const res = await fetch('https://dummyjson.com/users/add', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify(state)\n        })\n        const data = await res.json()\n        if (res.ok) {\n            successMessage.value = 'User registered successfully! Redirecting to login...'\n            setTimeout(() => router.push('/login'), 2000)\n        } else {\n            registerError.value = data.message || 'Registration failed!'\n        }\n    } catch (err) {\n        registerError.value = 'Something went wrong.'\n        console.error(err)\n    }\n}\n</script>\n<style lang=\"scss\" scoped>\nbody {\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n\n    .v-card {\n        backgroun