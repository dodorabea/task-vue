{"ast":null,"code":"export default {\n  data() {\n    return {\n      products: []\n    };\n  },\n  methods: {\n    async getProducts() {\n      await fetch('https://dummyjson.com/products').then(res => res.json()).then(data => this.products = data.products);\n    }\n  },\n  async mounted() {\n    await this.getProducts();\n  }\n};","map":{"version":3,"names":["data","products","methods","getProducts","fetch","then","res","json","mounted"],"sources":["/home/doha/Public/vue_study/product_app/src/views/ProdctsPage.vue"],"sourcesContent":["<template>\n    <div class=\"container\">\n        <v-container class=\"text-center\">\n            <h3 class=\"title\">Top-Selling Products🔥</h3>\n            <v-row density=\"comfortable\">\n                <v-col v-for=\"prod in products\" :key=\"prod.id\" cols=\"12\" md=\"4\">\n                    <v-card class=\"prodct__card mx-auto pa-4\" outlined variant=\"text\" rounded=\"xl\">\n                        <v-img color=\"\" height=\"336\" :src=\"prod.thumbnail\" />\n                        <v-card-text class=\"text-start\">\n                            <div class=\"prodct__card--title ellipsed\">{{ prod.title }}</div>\n                            <span class=\"prodct__card--price\">${{ prod.price.toFixed(2) }}</span>\n                        </v-card-text>\n                        <v-card-actions>\n                            <v-btn rounded=\"xs\" variant=\"outlined\" elevation=\"0\" color=\"green\" text=\"Learn More\"\n                                class=\"capitalize-text\" @click=\"reveal = true\"></v-btn>\n                        </v-card-actions>\n                    </v-card>\n\n                </v-col>\n            </v-row>\n        </v-container>\n\n    </div>\n</template>\n\n<style lang=\"scss\">\n.title{\n    position: relative;\n    font-size: 32px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 36px;\n    width: max-content;\n    padding-inline-start: 24px;\n    &::before{\n        content: '';\n        position: absolute;\n        display: block;\n        width: 3px;\n        height: calc(100% - 0px);\n        background-color: #4CAF50;\n        margin: 8px auto 16px;\n    }\n}\n.v-card {\n    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.1);\n}\n.prodct__card {\n    &--title {\n        font-size: 24px;\n        font-weight: 600;\n    }\n}\n\n.capitalize-text {\n    text-transform: capitalize;\n}\n\n.ellipsed {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n</style>\n<script>\nexport default {\n    data() {\n        return {\n            products: []\n        }\n    },\n    methods: {\n        async getProducts() {\n            await fetch('https://dummyjson.com/products')\n                .then((res) => res.json())\n                .then((data) => (this.products = data.products))\n        }\n    },\n    async mounted() {\n        await this.getProducts()\n    }\n}\n</script>"],"mappings":"AAiEA,eAAe;EACXA,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,OAAO,EAAE;IACL,MAAMC,WAAWA,CAAA,EAAG;MAChB,MAAMC,KAAK,CAAC,gCAAgC,EACvCC,IAAI,CAAEC,GAAG,IAAKA,GAAG,CAACC,IAAI,CAAC,CAAC,EACxBF,IAAI,CAAEL,IAAI,IAAM,IAAI,CAACC,QAAO,GAAID,IAAI,CAACC,QAAS;IACvD;EACJ,CAAC;EACD,MAAMO,OAAOA,CAAA,EAAG;IACZ,MAAM,IAAI,CAACL,WAAW,CAAC;EAC3B;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}