{"ast":null,"code":"export default {\n  data() {\n    return {\n      products: []\n    };\n  },\n  methods: {\n    async getProducts() {\n      await fetch('https://dummyjson.com/products').then(res => res.json()).then(data => this.products = data.products);\n    }\n  },\n  async mounted() {\n    await this.getProducts();\n  }\n};","map":{"version":3,"names":["data","products","methods","getProducts","fetch","then","res","json","mounted"],"sources":["/home/doha/Public/vue_study/product_app/src/views/ProdctsPage.vue"],"sourcesContent":["<template>\n    <div class=\"container\">\n        <v-container  class=\"text-center\">\n            <v-row density=\"comfortable\">\n                <v-col v-for=\"prod in products\" :key=\"prod.id\" cols=\"12\" md=\"4\">\n                    <v-card  class=\"prodct__card mx-auto\" color=\"\">\n                        <v-img color=\"\" height=\"336\" :src=\"prod.thumbnail\" />\n                        <v-card-text>\n                            <div class=\"prodct__card--title\">{{ prod.title }}</div>\n                            <span class=\"prodct__card--price\">${{ prod.price.toFixed(2) }}</span>\n                        </v-card-text>\n                          <v-card-actions>\n                            <v-btn\n                                color=\"teal-accent-4\"\n                                text=\"Learn More\"\n                                variant=\"text\"\n                                @click=\"reveal = true\"\n                            ></v-btn>\n                            </v-card-actions>\n                    </v-card>\n\n                </v-col>\n            </v-row>\n        </v-container>\n        \n    </div>\n</template>\n\n<style lang=\"scss\">\n    .prodct__card{\n        &--title{\n            font-size: 24px;\n            font-weight: 600;\n        }\n    }\n</style>\n<script>\nexport default {\n    data() {\n        return {\n            products: []\n        }\n    },\n    methods: {\n        async getProducts() {\n            await fetch('https://dummyjson.com/products')\n                .then((res) => res.json())\n                .then((data) => (this.products = data.products))\n        }\n    },\n    async mounted() {\n        await this.getProducts()\n    }\n}\n</script>"],"mappings":"AAqCA,eAAe;EACXA,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,OAAO,EAAE;IACL,MAAMC,WAAWA,CAAA,EAAG;MAChB,MAAMC,KAAK,CAAC,gCAAgC,EACvCC,IAAI,CAAEC,GAAG,IAAKA,GAAG,CAACC,IAAI,CAAC,CAAC,EACxBF,IAAI,CAAEL,IAAI,IAAM,IAAI,CAACC,QAAO,GAAID,IAAI,CAACC,QAAS;IACvD;EACJ,CAAC;EACD,MAAMO,OAAOA,CAAA,EAAG;IACZ,MAAM,IAAI,CAACL,WAAW,CAAC;EAC3B;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}