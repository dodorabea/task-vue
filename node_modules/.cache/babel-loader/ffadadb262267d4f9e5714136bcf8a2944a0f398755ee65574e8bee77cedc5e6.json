lass=\"rounded-pill\"></v-text-field>\n\n                            <v-text-field v-model=\"password\" :append-icon=\"show1 ? 'mdi-eye' : 'mdi-eye-off'\"\n                                :rules=\"[rules.required, rules.min]\" :type=\"show1 ? 'text' : 'password'\"\n                                hint=\"At least 8 characters\" label=\"Normal with hint text\" name=\"input-10-1\" counter\n                                @click:append=\"show1 = !show1\"></v-text-field>\n\n                            <div class=\"d-flex flex-wrap ga-3\">\n                                <v-btn @click=\"v$.$validate\" variant=\"outlined\" color=\"success\" type=\"submit\">\n                                    submit\n                                </v-btn>\n                                <v-btn @click=\"clear\" variant=\"elevated\" color=\"primary\">\n                                    clear\n                                </v-btn>\n                            </div>\n                        </form>\n                    </v-card>\n                </v-col>\n            </v-row>\n        </v-container>\n    </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\nimport { useVuelidate } from '@vuelidate/core'\nimport { email, required } from '@vuelidate/validators'\nimport { useRouter } from 'vue-router'\nconst initialState = {\n    name: '',\n    password: '',\n}\nconst rules = {\n    name: { required },\n    required: value => !!value || 'Required.',\n    min: v => v.length >= 8 || 'Min 8 characters',\n    emailMatch: () => (`The email and password you entered don't match`),\n}\n\nconst show1 = ref(false)\nconst password = ref('Password')\nconst state = reactive({\n    ...initialState,\n})\nconst v$ = useVuelidate(rules, state)\n\nfunction clear() {\n    v$.value.$reset()\n\n    for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value\n    }\n}\nconst router = useRouter()\nasync function handleSubmit() {\n    v$.value.$touch()\n    if (v$.value.$invalid) return\n\n    try {\n        const res = await fetch('https://dummyjson.com/auth/login', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({\n                username: state.email, // ممكن تحطي email بدل username\n                password: state.name    // أو أي حقل تحبي تستخدمه ككلمة مرور تجريبية\n            })\n        })\n\n        const data = await res.json()\n\n        if (res.ok) {\n            // تسجيل دخول ناجح\n            console.log('Login success:', data)\n            router.push('/products') // اذهب للـ products page\n        } else {\n            // تسجيل دخول فشل\n            console.error('Login failed:', data.message)\n            router.push('/404') // اذهب لصفحة 404\n        }\n    } catch (error) {\n        console.error('Error:', error)\n    }\n}\n</script>\n<style lang=\"scss\" scoped>\nbody {\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n\n    .v-card {\n        background: #FFF;\n        box-shadow: 0 4px 4px 0 rgb(1 37 4 / 10%);\n    }\n\n    .login__layout {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        min-height: calc(100vh - 200px);\n\n        &--title {\n            margin-bottom: 32px;\n\n            h1 {\n                font-size: 24px;\n                font-weight: 600;\n                color: #053E4B;\n            }\n\n            p {\n                font-size: 18px;\n                color: #6B6B6B;\n                font-weight: 300;\n            }\n        }\n    }\n}\n</style>"],"mappings":";;AAsCA,SAASA,GAAG,QAAQ,KAAI;AACxB,SAASC,YAAY,QAAQ,iBAAgB;AAC7C,SAASC,KAAK,EAAEC,QAAQ,QAAQ,uBAAsB;AACtD,SAASC,SAAS,QAAQ,YAAW;;;;;;;IACrC,MAAMC,YAAY,GAAG;MACjBC,IAAI,EAAE,EAAE;MACRC,QAAQ,EAAE;IACd;IACA,MAAMC,KAAK,GAAG;MACVF,IAAI,EAAE;QAAEH;MAAS,CAAC;MAClBA,QAAQ,EAAEM,KAAK,IAAI,CAAC,CAACA,KAAK,IAAI,WAAW;MACzCC,GAAG,EAAEC,CAAC,IAAIA,CAAC,CAACC,MAAM,IAAI,CAAC,IAAI,kBAAkB;MAC7CC,UAA