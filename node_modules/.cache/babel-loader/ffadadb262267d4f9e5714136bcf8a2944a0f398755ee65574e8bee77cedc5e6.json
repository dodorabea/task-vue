{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport { ref } from 'vue';\nimport { useVuelidate } from '@vuelidate/core';\nimport { email, required } from '@vuelidate/validators';\nimport { useRouter } from 'vue-router';\nexport default {\n  __name: 'Login',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const initialState = {\n      name: '',\n      password: ''\n    };\n    const rules = {\n      name: {\n        required\n      },\n      required: value => !!value || 'Required.',\n      min: v => v.length >= 8 || 'Min 8 characters',\n      emailMatch: () => `The email and password you entered don't match`\n    };\n    const show1 = ref(false);\n    const password = ref('Password');\n    const state = reactive({\n      ...initialState\n    });\n    const v$ = useVuelidate(rules, state);\n    function clear() {\n      v$.value.$reset();\n      for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value;\n      }\n    }\n    const router = useRouter();\n    async function handleSubmit() {\n      v$.value.$touch();\n      if (v$.value.$invalid) return;\n      try {\n        const res = await fetch('https://dummyjson.com/auth/login', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            username: state.email,\n            // ممكن تحطي email بدل username\n            password: state.name // أو أي حقل تحبي تستخدمه ككلمة مرور تجريبية\n          })\n        });\n        const data = await res.json();\n        if (res.ok) {\n          // تسجيل دخول ناجح\n          console.log('Login success:', data);\n          router.push('/products'); // اذهب للـ products page\n        } else {\n          // تسجيل دخول فشل\n          console.error('Login failed:', data.message);\n          router.push('/404'); // اذهب لصفحة 404\n        }\n      } catch (error) {\