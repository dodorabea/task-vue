{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport { reactive, ref } from 'vue';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required } from '@vuelidate/validators';\nimport { useRouter } from 'vue-router';\nexport default {\n  __name: 'Login',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const initialState = {\n      username: '',\n      password: ''\n    };\n    const loginError = ref('');\n    function clear() {\n      v$.value.$reset();\n      for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value;\n        loginError.value = '';\n      }\n    }\n    const visible = ref(false);\n    async function handleLogin() {\n      loginError.value = '';\n      try {\n        const res = await fetch('https://dummyjson.com/auth/login', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            username: state.username,\n            password: state.password\n          }),\n          credentials: 'include'\n        });\n        const data = await res.json();\n        if (res.ok) {\n          localStorage.setItem('token', data.token); // حفظ JWT\n          router.push('/products');\n        } else {\n          loginError.value = 'Username or password is incorrect!';\n        }\n      } catch (err) {\n        loginError.value = 'Something went wrong.';\n        console.error(err);\n      }\n    }\n    const __returned__ = {\n      router,\n      initialState,\n      loginError,\n      clear,\n      visible,\n      handleLogin,\n      reactive,\n      ref,\n      get useVuelidate() {\n        return useVuelidate;\n      },\n      get required() {\n        return required;\n      },\n      get useRouter() {\n        return useRouter;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","ref","useVuelidate","required","useRouter","router","initialState","username","password","loginError","clear","v$","value","$reset","key","Object","entries","state","visible","handleLogin","res","fetch","method","headers","body","JSON","stringify","credentials","data","json","ok","localStorage","setItem","token","push","err","console","error"],"sources":["/home/doha/Public/vue_study/product_app/src/views/Login.vue"],"sourcesContent":["<template>\n    <div class=\"login__layout\">\n        <v-container>\n            <v-row justify=\"center\">\n                <v-col cols=\"12\" md=\"6\">\n                    <v-card class=\"pa-5\" rounded=\"xl\">\n                        <v-card-text class=\"login__layout--title text-center\">\n                            <h1>Welcome Back</h1>\n                            <p>Let’s get you back to shopping and exploring.</p>\n                        </v-card-text>\n\n                        <form class=\"d-flex flex-column ga-4\" @submit.prevent=\"handleLogin\">\n                            <v-text-field v-model=\"state.username\"\n                                :error-messages=\"v$.username.$errors.map(e => e.$message)\" label=\"Username\" required\n                                @blur=\"v$.username.$touch\" @input=\"v$.username.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n\n                            <v-text-field v-model=\"state.password\"\n                                :error-messages=\"v$.password.$errors.map(e => e.$message)\" label=\"Password\" required\n                                @blur=\"v$.password.$touch\" @input=\"v$.password.$touch\"\n                                :append-inner-icon=\"visible ? 'mdi-eye-off' : 'mdi-eye'\"\n                                :type=\"visible ? 'text' : 'password'\" @click:append-inner=\"visible = !visible\"\n                                class=\"rounded-pill\"></v-text-field>\n\n                            <div class=\"d-flex flex-wrap ga-3\">\n                                <v-btn @click=\"v$.$validate\" variant=\"outlined\" color=\"success\" type=\"submit\">\n                                    submit\n                                </v-btn>\n                                <v-btn @click=\"clear\" variant=\"elevated\" color=\"primary\">\n                                    clear\n                                </v-btn>\n                            </div>\n                            <div v-if=\"loginError\" class=\"login__error text-center mb-3\">\n                                <v-alert type=\"error\" variant=\"outlined\">\n                                    {{ loginError }}\n                                </v-alert>\n                            </div>\n                        </form>\n\n                    </v-card>\n                </v-col>\n            </v-row>\n        </v-container>\n    </div>\n</template>\n\n<script setup>\nimport { reactive, ref } from 'vue'\nimport { useVuelidate } from '@vuelidate/core'\nimport { required } from '@vuelidate/validators'\nimport { useRouter } from 'vue-router'\n\nconst router = useRouter()\n\nconst initialState = {\n    username: '',\n    password: '',\n}\nconst loginError = ref('')\n\n\n\n\n\n\n\nfunction clear() {\n    v$.value.$reset()\n\n    for (const [key, value] of Object.entries(initialState)) {\n        state[key] = value\n        loginError.value = ''\n    }\n}\nconst visible = ref(false)\nasync function handleLogin() {\n  loginError.value = ''\n  try {\n    const res = await fetch('https://dummyjson.com/auth/login', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        username: state.username,\n        password: state.password\n      }),\n      credentials: 'include'\n    })\n    const data = await res.json()\n    if (res.ok) {\n      localStorage.setItem('token', data.token) // حفظ JWT\n      router.push('/products')\n    } else {\n      loginError.value = 'Username or password is incorrect!'\n    }\n  } catch (err) {\n    loginError.value = 'Something went wrong.'\n    console.error(err)\n  }\n}\n</script>\n<style lang=\"scss\" scoped>\nbody {\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n\n    .v-card {\n        background: #FFF;\n        box-shadow: 0 4px 4px 0 rgb(1 37 4 / 10%);\n    }\n\n    .login__layout {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        min-height: calc(100vh - 200px);\n\n        &--title {\n            margin-bottom: 32px;\n\n            h1 {\n                font-size: 24px;\n                font-weight: 600;\n                color: #053E4B;\n            }\n\n            p {\n                font-size: 18px;\n                color: #6B6B6B;\n                font-weight: 300;\n            }\n        }\n    }\n}\n</style>"],"mappings":";;AA+CA,SAASA,QAAQ,EAAEC,GAAG,QAAQ,KAAI;AAClC,SAASC,YAAY,QAAQ,iBAAgB;AAC7C,SAASC,QAAQ,QAAQ,uBAAsB;AAC/C,SAASC,SAAS,QAAQ,YAAW;;;;;;;IAErC,MAAMC,MAAM,GAAGD,SAAS,CAAC;IAEzB,MAAME,YAAY,GAAG;MACjBC,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE;IACd;IACA,MAAMC,UAAU,GAAGR,GAAG,CAAC,EAAE;IAQzB,SAASS,KAAKA,CAAA,EAAG;MACbC,EAAE,CAACC,KAAK,CAACC,MAAM,CAAC;MAEhB,KAAK,MAAM,CAACC,GAAG,EAAEF,KAAK,CAAC,IAAIG,MAAM,CAACC,OAAO,CAACV,YAAY,CAAC,EAAE;QACrDW,KAAK,CAACH,GAAG,CAAC,GAAGF,KAAI;QACjBH,UAAU,CAACG,KAAK,GAAG,EAAC;MACxB;IACJ;IACA,MAAMM,OAAO,GAAGjB,GAAG,CAAC,KAAK;IACzB,eAAekB,WAAWA,CAAA,EAAG;MAC3BV,UAAU,CAACG,KAAK,GAAG,EAAC;MACpB,IAAI;QACF,MAAMQ,GAAG,GAAG,MAAMC,KAAK,CAAC,kCAAkC,EAAE;UAC1DC,MAAM,EAAE,MAAM;UACdC,OAAO,EAAE;YAAE,cAAc,EAAE;UAAmB,CAAC;UAC/CC,IAAI,EAAEC,IAAI,CAACC,SAAS,CAAC;YACnBnB,QAAQ,EAAEU,KAAK,CAACV,QAAQ;YACxBC,QAAQ,EAAES,KAAK,CAACT;UAClB,CAAC,CAAC;UACFmB,WAAW,EAAE;QACf,CAAC;QACD,MAAMC,IAAI,GAAG,MAAMR,GAAG,CAACS,IAAI,CAAC;QAC5B,IAAIT,GAAG,CAACU,EAAE,EAAE;UACVC,YAAY,CAACC,OAAO,CAAC,OAAO,EAAEJ