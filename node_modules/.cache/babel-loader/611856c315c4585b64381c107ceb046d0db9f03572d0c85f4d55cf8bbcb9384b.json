{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport { reactive, ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { required, email } from '@vuelidate/validators';\nimport { useVuelidate } from '@vuelidate/core';\nexport default {\n  __name: 'register',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n\n    //Use Composition Api\n    const router = useRouter();\n    const state = reactive({\n      firstName: '',\n      lastName: '',\n      username: '',\n      email: '',\n      password: ''\n    });\n    const visible = ref(false);\n    const registerError = ref('');\n    const successMessage = ref('');\n    const rules = {\n      firstName: {\n        required\n      },\n      lastName: {\n        required\n      },\n      username: {\n        required\n      },\n      email: {\n        required,\n        email\n      },\n      password: {\n        required\n      }\n    };\n    const v$ = useVuelidate(rules, state);\n    function clear() {\n      v$.value.$reset();\n      Object.keys(state).forEach(key => state[key] = '');\n      registerError.value = '';\n      successMessage.value = '';\n    }\n    async function handleRegister() {\n      registerError.value = '';\n      successMessage.value = '';\n      try {\n        const res = await fetch('https://dummyjson.com/users/add', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify(state)\n        });\n        const data = await res.json();\n        if (res.ok) {\n          successMessage.value = 'User registered successfully! Redirecting to login...';\n          setTimeout(() => router.push('/login'), 1000);\n        } else {\n          registerError.value = data.message || 'Registration failed!';\n        }\n      } catch (err) {\n        registerError.value = 'Something went wrong.';\n        console.error(err);\n      }\n    }\n    const __returned__ = {\n      router,\n      state,\n      visible,\n      registerError,\n      successMessage,\n      rules,\n      v$,\n      clear,\n      handleRegister,\n      reactive,\n      ref,\n      get useRouter() {\n        return useRouter;\n      },\n      get required() {\n        return required;\n      },\n      get email() {\n        return email;\n      },\n      get useVuelidate() {\n        return useVuelidate;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","ref","useRouter","required","email","useVuelidate","router","state","firstName","lastName","username","password","visible","registerError","successMessage","rules","v$","clear","value","$reset","Object","keys","forEach","key","handleRegister","res","fetch","method","headers","body","JSON","stringify","data","json","ok","setTimeout","push","message","err","console","error"],"sources":["/home/doha/Public/vue_study/product_app/src/views/register.vue"],"sourcesContent":["<template>\n    <div class=\"login__layout\">\n        <v-container>\n            <v-row justify=\"center\">\n                <v-col cols=\"12\" md=\"6\">\n                    <!--Success Message-->\n                    <div v-if=\"successMessage\" class=\"login__error text-center mb-3\">\n                        <v-alert type=\"success\" variant=\"outlined\">\n                            {{ successMessage }}\n                        </v-alert>\n                    </div>\n                    <!--Login Error-->\n                    <div v-if=\"registerError\" class=\"login__error text-center mb-3\">\n                        <v-alert type=\"error\" variant=\"outlined\">\n                            {{ registerError }}\n                        </v-alert>\n                    </div>\n                    <v-card class=\"pa-5\" rounded=\"xl\">\n                        <v-card-text class=\"login__layout--title text-center\">\n                            <h1>Welcome Back</h1>\n                            <p>Let’s get you back to shopping and exploring.</p>\n                        </v-card-text>\n\n                        <form class=\"d-flex flex-column ga-4\" @submit.prevent=\"handleRegister\">\n                            <!--First name-->\n                            <v-text-field v-model=\"state.firstName\"\n                                :error-messages=\"v$.firstName.$errors.map(e => e.$message)\" label=\"First Name\" required\n                                @blur=\"v$.firstName.$touch\" @input=\"v$.firstName.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n                            <!--Last Name-->\n                            <v-text-field v-model=\"state.lastName\"\n                                :error-messages=\"v$.lastName.$errors.map(e => e.$message)\" label=\"Last Name\" required\n                                @blur=\"v$.lastName.$touch\" @input=\"v$.lastName.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n                            <!--User Name-->\n                            <v-text-field v-model=\"state.username\"\n                                :error-messages=\"v$.username.$errors.map(e => e.$message)\" label=\"User Name\" required\n                                @blur=\"v$.username.$touch\" @input=\"v$.username.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n                            <!--Email-->\n                            <v-text-field v-model=\"state.email\" :error-messages=\"v$.email.$errors.map(e => e.$message)\"\n                                label=\"Email\" required @blur=\"v$.email.$touch\" @input=\"v$.email.$touch\"\n                                class=\"rounded-pill\"></v-text-field>\n                            <!--Password -->\n                            <v-text-field v-model=\"state.password\"\n                                :error-messages=\"v$.password.$errors.map(e => e.$message)\" label=\"Password\" required\n                                @blur=\"v$.password.$touch\" @input=\"v$.password.$touch\"\n                                :append-inner-icon=\"visible ? 'mdi-eye-off' : 'mdi-eye'\"\n                                :type=\"visible ? 'text' : 'password'\" @click:append-inner=\"visible = !visible\"\n                                class=\"rounded-pill\"></v-text-field>\n\n                            <div class=\"d-flex flex-wrap ga-3\">\n                                <v-btn @click=\"v$.$validate\" variant=\"outlined\" color=\"success\" type=\"submit\">\n                                    submit\n                                </v-btn>\n                                <v-btn @click=\"clear\" variant=\"elevated\" color=\"primary\">\n                                    clear\n                                </v-btn>\n                            </div>\n                        </form>\n                         <v-card-actions class=\"d-flex justify-center pt-5\" align=\"center\">\n                           <div class=\"text-center\">\n                                Already have account <v-btn variant=\"text\" color=\"info\">Login</v-btn>\n                           </div>\n                        </v-card-actions>\n\n                    </v-card>\n                </v-col>\n            </v-row>\n        </v-container>\n    </div>\n</template>\n\n<script setup>\n//Use Composition Api\nimport { reactive, ref } from 'vue'\nimport { useRouter } from 'vue-router'\nimport { required, email } from '@vuelidate/validators'\nimport { useVuelidate } from '@vuelidate/core'\nconst router = useRouter()\nconst state = reactive({\n    firstName: '',\n    lastName: '',\n    username: '',\n    email: '',\n    password: ''\n})\nconst visible = ref(false)\nconst registerError = ref('')\nconst successMessage = ref('')\n\n\nconst rules = {\n    firstName: { required },\n    lastName: { required },\n    username: { required },\n    email: { required, email },\n    password: { required }\n}\nconst v$ = useVuelidate(rules, state)\n\nfunction clear() {\n    v$.value.$reset()\n    Object.keys(state).forEach(key => state[key] = '')\n    registerError.value = ''\n    successMessage.value = ''\n}\nasync function handleRegister() {\n    registerError.value = ''\n    successMessage.value = ''\n\n    try {\n        const res = await fetch('https://dummyjson.com/users/add', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify(state)\n        })\n        const data = await res.json()\n        if (res.ok) {\n            successMessage.value = 'User registered successfully! Redirecting to login...'\n            setTimeout(() => router.push('/login'), 1000)\n        } else {\n            registerError.value = data.message || 'Registration failed!'\n        }\n    } catch (err) {\n        registerError.value = 'Something went wrong.'\n        console.error(err)\n    }\n}\n</script>\n<style lang=\"scss\" scoped>\nbody {\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n\n    .v-card {\n        background: #FFF;\n        box-shadow: 0 4px 4px 0 rgb(1 37 4 / 10%);\n    }\n\n    .login__layout {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        min-height: calc(100vh - 200px);\n\n        &--title {\n            margin-bottom: 32px;\n\n            h1 {\n                font-size: 24px;\n                font-weight: 600;\n                color: #053E4B;\n            }\n\n            p {\n                font-size: 18px;\n                color: #6B6B6B;\n                font-weight: 300;\n            }\n        }\n    }\n}\n</style>"],"mappings":";;;;AA2EA,SAASA,QAAQ,EAAEC,GAA