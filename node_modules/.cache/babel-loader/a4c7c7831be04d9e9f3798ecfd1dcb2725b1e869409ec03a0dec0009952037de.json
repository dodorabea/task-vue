egory)) {\n                const currentPage = this.pageNumbers[category] || 1;\n                const start = (currentPage - 1) * this.itemsPerPage;\n                const end = start + this.itemsPerPage;\n                paginated[category] = items.slice(start, end);\n            }\n            return paginated;\n        }\n    },\n    // methods: {\n    //     async getProducts() {\n    //         await fetch('https://dummyjson.com/products')\n    //             .then((res) => res.json())\n    //             .then((data) => (this.products = data.products))\n    //     }\n    // },\n   \n    methods: {\n        async getProducts() {\n            await fetch('https://dummyjson.com/products')\n                .then((res) => res.json())\n                .then((data) => (this.products = data.products))\n\n            // Initialize pageNumbers لكل category\n            const groups = {};\n            data.products.forEach(prod => {\n                if (!groups[prod.category]) groups[prod.category] = 1;\n            });\n            this.pageNumbers = groups;\n        },\n        prevPage(category) {\n            if (this.pageNumbers[category] > 1) {\n                this.pageNumbers[category]--;\n            }\n        },\n        nextPage(category) {\n            if (this.pageNumbers[category] < Math.ceil(this.groupedByCategory[category].length / this.itemsPerPage)) {\n                this.pageNumbers[category]++;\n            }\n        }\n    },\n     async mounted() {\n        await this.getProducts()\n    },\n}\n</script>"],"mappings":";;;AAuFA,eAAe;EACXA,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,QAAQ,EAAE,EAAE;MACZC,YAAY,EAAE,CAAC;MACfC,WAAW,EAAE,CAAC;IAClB;EACJ,CAAC;EACDC,QAAQ,EAAE;IACNC,iBAAiBA,CAAA,EAAG;MAChB,MAAMC,MAAK,GAAI,CAAC,CAAC;MACjB,IAAI,CAACL,QAAQ,CAACM,OAAO,CAACC,IAAG,IAAK;QAC1B,MAAMC,GAAE,GAAID,IAAI,CAACE,QAAQ;QACzB,IAAI,CAACJ,MAAM,CAACG,GAAG,CAAC,EAAEH,MAAM,CAACG,GAAG,IAAI,EAAE;QAClCH,MAAM,CAACG,GAAG,CAAC,CAACE,IAAI,CAACH,IAAI,CAAC;MAC1B,CAAC,CAAC;MACF,OAAOF