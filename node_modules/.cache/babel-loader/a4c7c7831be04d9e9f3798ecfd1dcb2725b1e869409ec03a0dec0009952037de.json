{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nexport default {\n  data() {\n    return {\n      products: [],\n      itemsPerPage: 6,\n      pageNumbers: {}\n    };\n  },\n  computed: {\n    groupedByCategory() {\n      const groups = {};\n      this.products.forEach(prod => {\n        const cat = prod.category;\n        if (!groups[cat]) groups[cat] = [];\n        groups[cat].push(prod);\n      });\n      return groups;\n    },\n    paginatedGroups() {\n      const paginated = {};\n      for (const [category, items] of Object.entries(this.groupedByCategory)) {\n        const currentPage = this.pageNumbers[category] || 1;\n        const start = (currentPage - 1) * this.itemsPerPage;\n        const end = start + this.itemsPerPage;\n        paginated[category] = items.slice(start, end);\n      }\n      return paginated;\n    }\n  },\n  // methods: {\n  //     async getProducts() {\n  //         await fetch('https://dummyjson.com/products')\n  //             .then((res) => res.json())\n  //             .then((data) => (this.products = data.products))\n  //     }\n  // },\n\n  methods: {\n    async getProducts() {\n      await fetch('https://dummyjson.com/products').then(res => res.json()).then(data => this.products = data.products);\n\n      // Initialize pageNumbers لكل category\n      const groups = {};\n      data.products.forEach(prod => {\n        if (!groups[prod.category]) groups[prod.category] = 1;\n      });\n      this.pageNumbers = groups;\n    },\n    prevPage(category) {\n      if (this.pageNumbers[category] > 1) {\n        this.pageNumbers[category]--;\n      }\n    },\n    nextPage(category) {\n      if (this.pageNumbers[category] < Math.ceil(this.groupedByCategory[category].length / this.itemsPerPage)) {\n        this.pageNumbers[category]++;\n      }\n    }\n  },\n  async mounted() {\n    await this.getProducts();\n  }\n};","