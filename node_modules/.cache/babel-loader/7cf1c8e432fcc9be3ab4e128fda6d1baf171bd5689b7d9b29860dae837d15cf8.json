{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport ProductCard from '../components/ProductCard.vue';\nexport default {\n  components: {\n    ProductCard\n  },\n  data() {\n    return {\n      products: [],\n      valid: true,\n      searchQuery: \"\"\n    };\n  },\n  computed: {\n    // اجمع المنتجات حسب الكاتيجوري\n    groupedByCategory() {\n      const groups = {};\n      this.products.forEach(product => {\n        if (!groups[product.category]) {\n          groups[product.category] = [];\n        }\n        groups[product.category].push(product);\n      });\n      return groups;\n    },\n    // الفلترة حسب البحث\n    filteredGroupedByCategory() {\n      const query = this.searchQuery.toLowerCase();\n      const filteredGroups = {};\n      Object.keys(this.groupedByCategory).forEach(category => {\n        const filteredItems = this.groupedByCategory[category].filter(prod => prod.name && prod.name.toLowerCase().includes(query));\n        if (filteredItems.length) {\n          filteredGroups[category] = filteredItems;\n        }\n      });\n      return filteredGroups;\n    }\n  },\n  methods: {\n    async getProducts() {\n      await fetch('https://dummyjson.com/products').then(res => res.json()).then(data => this.products = data.products);\n    }\n  },\n  async mounted() {\n    await this.getProducts();\n  }\n};","map":{"version":3,"names":["ProductCard","components","data","products","valid","searchQuery","computed","groupedByCategory","groups","forEach","product","category","push","filteredGroupedByCategory","query","toLowerCase","filteredGroups","Object","keys","filteredItems","filter","prod","name","includes","length","methods","getProducts","fetch","then","res","json","mounted"],"sources":["/home/doha/Public/vue_study/product_app/src/views/ProdctsPage.vue"],"sourcesContent":["<template>\n    <v-container>\n        <v-form v-model=\"valid\">\n            <v-container>\n                <v-row>\n                    <v-col cols=\"12\" md=\"12\">\n                        <v-text-field v-model=\"searchQuery\" label=\"search and filter products...\" clearable\n                            required></v-text-field>\n                    </v-col>\n                </v-row>\n            </v-container>\n        </v-form>\n    </v-container>\n    <v-container class=\"text-center\">\n        <div v-for=\"(items, category) in filteredGroupedByCategory\" :key=\"category\" class=\"category-group pb-9\">\n            <h4 class=\"title mb-4 capitalize-text\">{{ category }} Groups ⚡</h4>\n            <v-row density=\"comfortable\">\n                <v-col v-for=\"prod in items\" :key=\"prod.id\" cols=\"12\" md=\"4\">\n                    <ProductCard :product=\"prod\" />\n                </v-col>\n            </v-row>\n            <v-divider :thickness=\"2\" class=\"border-opacity-25 mt-9\" color=\"success\"></v-divider>\n        </div>\n\n    </v-container>\n</template>\n\n<style lang=\"scss\">\n.title {\n    position: relative;\n    font-size: 32px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 36px;\n    width: max-content;\n    padding-inline-start: 16px;\n\n    &::before {\n        content: '';\n        position: absolute;\n        display: block;\n        width: 3px;\n        height: calc(100% - 0px);\n        background-color: #4CAF50;\n        border-radius: 25px;\n        inset-inline-start: 0;\n    }\n}\n\n.v-card {\n    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.1);\n}\n\n.prodct__card {\n    &--title {\n        font-size: 24px;\n        font-weight: 600;\n    }\n}\n\n.capitalize-text {\n    text-transform: capitalize;\n}\n\n.ellipsed {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n</style>\n<script>\nimport ProductCard from '../components/ProductCard.vue';\nexport default {\n    components: {\n        ProductCard\n    },\n    data() {\n        return {\n            products: [],\n            valid: true,\n      searchQuery: \"\"\n        }\n    },\n    computed: {\n    // اجمع المنتجات حسب الكاتيجوري\n    groupedByCategory() {\n      const groups = {};\n      this.products.forEach((product) => {\n        if (!groups[product.category]) {\n          groups[product.category] = [];\n        }\n        groups[product.category].push(product);\n      });\n      return groups;\n    },\n\n    // الفلترة حسب البحث\n   filteredGroupedByCategory() {\n  const query = this.searchQuery.toLowerCase();\n  const filteredGroups = {};\n\n  Object.keys(this.groupedByCategory).forEach((category) => {\n    const filteredItems = this.groupedByCategory[category].filter((prod) =>\n      prod.name && prod.name.toLowerCase().includes(query)\n    );\n    if (filteredItems.length) {\n      filteredGroups[category] = filteredItems;\n    }\n  });\n\n  return filteredGroups;\n}\n  },\n    methods: {\n        async getProducts() {\n            await fetch('https://dummyjson.com/products')\n                .then((res) => res.json())\n                .then((data) => (this.products = data.products))\n        }\n    },\n    async mounted() {\n        await this.getProducts()\n    }\n}\n</script>"],"mappings":";;;;AAuEA,OAAOA,WAAU,MAAO,+BAA+B;AACvD,eAAe;EACXC,UAAU,EAAE;IACRD;EACJ,CAAC;EACDE,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,IAAI;MACjBC,WAAW,EAAE;IACX;EACJ,CAAC;EACDC,QAAQ,EAAE;IACV;IACAC,iBAAiBA,CAAA,EAAG;MAClB,MAAMC,MAAK,GAAI,CAAC,CAAC;MACjB,IAAI,CAACL,QAAQ,CAACM,OAAO,CAAEC,OAAO,IAAK;QACjC,IAAI,CAACF,MAAM,CAACE,OAAO,CAACC,QAAQ,CAAC,EAAE;UAC7BH,MAAM,CAACE,OAAO,CAACC,QAAQ,IAAI,EAAE;QAC/B;QACAH,MAAM,CAACE,OAAO,CAACC,QAAQ,CAAC,CAACC,IAAI,CAACF,OAAO,CAAC;MACxC,CAAC,CAAC;MACF,OAAOF,MAAM;IACf,CAAC;IAED;IACDK,yBAAyBA,CAAA,EAAG;MAC7B,MAAMC,KAAI,GAAI,IAAI,CAACT,WAAW,CAACU,WAAW,CAAC,CAAC;MAC5C,MAAMC,cAAa,GAAI,CAAC,CAAC;MAEzBC,MAAM,CAACC,IAAI,CAAC,IAAI,CAACX,iBAAiB,CAAC,CAACE,OAAO,