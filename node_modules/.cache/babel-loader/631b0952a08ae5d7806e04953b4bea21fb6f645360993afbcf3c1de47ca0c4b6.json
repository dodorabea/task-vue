{"ast":null,"code":"export default {\n  data() {\n    return {\n      product: null\n    };\n  },\n  async mounted() {\n    const productId = this.$route.params.id;\n    const res = await fetch('https://dummyjson.com/products/' + productId);\n    const data = await res.json();\n    this.product = data;\n  }\n};","map":{"version":3,"names":["data","product","mounted","productId","$route","params","id","res","fetch","json"],"sources":["/home/doha/Public/vue_study/product_app/src/views/ProductPageDetails.vue"],"sourcesContent":["<template>\n   <v-container class=\"text-center\" v-if=\"product\">\n  <v-row density=\"comfortable\">\n    <v-col cols=\"12\" md=\"4\">\n      <v-img :src=\"product.thumbnail\" height=\"336\"/>\n    </v-col>\n    <v-col cols=\"12\" md=\"8\">\n      <v-card class=\"prodct__card mx-auto pa-4\" outlined variant=\"text\" rounded=\"lg\">\n        <v-card-text class=\"text-start\">\n          <h2>{{ product.title }}</h2>\n          <p>{{ product.description }}</p>\n          <p>Price: ${{ product.price.toFixed(2) }}</p>\n        </v-card-text>\n      </v-card>\n    </v-col>\n  </v-row>\n</v-container>\n\n<div v-else>Loading...</div>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      product: null,\n    }\n  },\n  async mounted() {\n    const productId = this.$route.params.id;\n    const res = await fetch('https://dummyjson.com/products/' + productId);\n    const data = await res.json();\n    this.product = data;\n  }\n}\n</script>"],"mappings":"AAqBA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;IACX;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAMC,SAAQ,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACC,EAAE;IACvC,MAAMC,GAAE,GAAI,MAAMC,KAAK,CAAC,iCAAgC,GAAIL,SAAS,CAAC;IACtE,MAAMH,IAAG,GAAI,MAAMO,GAAG,CAACE,IAAI,CAAC,CAAC;IAC7B,IAAI,CAACR,OAAM,GAAID,IAAI;EACrB;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}