{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nexport default {\n  data() {\n    return {\n      products: []\n    };\n  },\n  computed: {\n    groupedByCategory() {\n      const groups = {};\n      this.products.forEach(prod => {\n        const cat = prod.category;\n        if (!groups[cat]) groups[cat] = [];\n        groups[cat].push(prod);\n      });\n      return groups;\n    }\n  },\n  methods: {\n    async getProducts() {\n      await fetch('https://dummyjson.com/products').then(res => res.json()).then(data => this.products = data.products);\n    }\n  },\n  async mounted() {\n    await this.getProducts();\n  }\n};","map":{"version":3,"names":["data","products","computed","groupedByCategory","groups","forEach","prod","cat","category","push","methods","getProducts","fetch","then","res","json","mounted"],"sources":["/home/doha/Public/vue_study/product_app/src/views/ProdctsPage.vue"],"sourcesContent":["<template>\n  <v-container class=\"text-center\">\n      <h3 class=\"title mb-4\">Top-Selling Products🔥</h3>\n\n      <div v-for=\"(items, category) in groupedByCategory\" :key=\"category\" class=\"category-group\">\n        <h4 class=\"text-h5 mb-3 text-start\">{{ category }}</h4>\n        <v-row density=\"comfortable\">\n          <v-col v-for=\"prod in items\" :key=\"prod.id\" cols=\"12\" md=\"4\">\n            <v-card class=\"prodct__card mx-auto pa-4\" outlined variant=\"text\" rounded=\"xl\">\n              <v-img color=\"\" height=\"336\" :src=\"prod.thumbnail\" />\n              <v-card-text class=\"text-start\">\n                <div class=\"prodct__card--title ellipsed\">{{ prod.title }}</div>\n                <span class=\"prodct__card--price\">${{ prod.price.toFixed(2) }}</span>\n              </v-card-text>\n              <v-card-actions>\n                <v-btn rounded=\"xs\" variant=\"outlined\" elevation=\"0\" color=\"green\"\n                       class=\"capitalize-text\" @click=\"reveal = true\">\n                  Learn More\n                </v-btn>\n              </v-card-actions>\n            </v-card>\n          </v-col>\n        </v-row>\n      </div>\n\n    </v-container>\n</template>\n\n<style lang=\"scss\">\n.title {\n    position: relative;\n    font-size: 32px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 36px;\n    width: max-content;\n    padding-inline-start: 16px;\n\n    &::before {\n        content: '';\n        position: absolute;\n        display: block;\n        width: 3px;\n        height: calc(100% - 0px);\n        background-color: #4CAF50;\n        border-radius: 25px;\n        inset-inline-start: 0;\n    }\n}\n\n.v-card {\n    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.1);\n}\n\n.prodct__card {\n    &--title {\n        font-size: 24px;\n        font-weight: 600;\n    }\n}\n\n.capitalize-text {\n    text-transform: capitalize;\n}\n\n.ellipsed {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n</style>\n<script>\nexport default {\n    data() {\n        return {\n            products: []\n        }\n    },\n    computed: {\n        groupedByCategory() {\n            const groups = {};\n            this.products.forEach(prod => {\n                const cat = prod.category;\n                if (!groups[cat]) groups[cat] = [];\n                groups[cat].push(prod);\n            });\n            return groups;\n        }\n    },\n    methods: {\n        async getProducts() {\n            await fetch('https://dummyjson.com/products')\n                .then((res) => res.json())\n                .then((data) => (this.products = data.products))\n        }\n    },\n    async mounted() {\n        await this.getProducts()\n    }\n}\n</script>"],"mappings":";;;AAwEA,eAAe;EACXA,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,QAAQ,EAAE;IACNC,iBAAiBA,CAAA,EAAG;MAChB,MAAMC,MAAK,GAAI,CAAC,CAAC;MACjB,IAAI,CAACH