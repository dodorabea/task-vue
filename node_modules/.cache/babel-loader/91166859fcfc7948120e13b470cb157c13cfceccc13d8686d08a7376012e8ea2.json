{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nexport default {\n  data() {\n    return {\n      products: [],\n      itemsPerPage: 6,\n      pageNumbers: {}\n    };\n  },\n  computed: {\n    groupedByCategory() {\n      const groups = {};\n      this.products.forEach(prod => {\n        const cat = prod.category;\n        if (!groups[cat]) groups[cat] = [];\n        groups[cat].push(prod);\n      });\n      return groups;\n    }\n  },\n  methods: {\n    async getProducts() {\n      await fetch('https://dummyjson.com/products').then(res => res.json()).then(data => this.products = data.products);\n    }\n  },\n  async mounted() {\n    await this.getProducts();\n  }\n};","map":{"version":3,"names":["data","products","itemsPerPage","pageNumbers","computed","groupedByCategory","groups","forEach","prod","cat","category","push","methods","getProducts","fetch","then","res","json","mounted"],"sources":["/home/doha/Public/vue_study/product_app/src/views/ProdctsPage.vue"],"sourcesContent":["<template>\n    <v-container class=\"text-center\">\n        <div v-for=\"(items, category) in groupedByCategory\" :key=\"category\" class=\"category-group mb-4\">\n            <h4 class=\"title mb-4 capitalize-text\">{{ category }} Groups</h4>\n            <v-row density=\"comfortable\">\n                <v-col v-for=\"prod in items\" :key=\"prod.id\" cols=\"12\" md=\"4\">\n                    <v-card class=\"prodct__card mx-auto pa-4\" outlined variant=\"text\" rounded=\"xl\">\n                        <v-img color=\"\" height=\"336\" :src=\"prod.thumbnail\" />\n                        <v-card-text class=\"text-start\">\n                            <div class=\"prodct__card--title ellipsed\">{{ prod.title }}</div>\n                            <span class=\"prodct__card--price\">${{ prod.price.toFixed(2) }}</span>\n                        </v-card-text>\n                        <v-card-actions>\n                            <v-btn rounded=\"xs\" \n                            variant=\"outlined\" \n                            elevation=\"0\" \n                            color=\"green\" \n                            class=\"capitalize-text\"\n                            @click=\"reveal = true\">\n                                Learn More\n                            </v-btn>\n                        </v-card-actions>\n                    </v-card>\n                </v-col>\n            </v-row>\n        </div>\n\n    </v-container>\n</template>\n\n\n<script>\nexport default {\n    data() {\n        return {\n            products: [],\n            itemsPerPage: 6,\n            pageNumbers: {}\n        }\n    },\n    computed: {\n        groupedByCategory() {\n            const groups = {};\n            this.products.forEach(prod => {\n                const cat = prod.category;\n                if (!groups[cat]) groups[cat] = [];\n                groups[cat].push(prod);\n            });\n            return groups;\n            \n        }\n    },\n    methods: {\n        async getProducts() {\n            await fetch('https://dummyjson.com/products')\n                .then((res) => res.json())\n                .then((data) => (this.products = data.products))\n        }\n    },\n    async mounted() {\n        await this.getProducts()\n    }\n}\n</script>"],"mappings":";;;AAgCA,eAAe;EACXA,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,QAAQ,EAAE,EAAE;MACZC,YAAY,EAAE,CAAC;MACfC,WAAW,EAAE,CAAC;IAClB;EACJ,CAAC;EACDC,QAAQ,EAAE;IACNC,iBAAiBA,CAAA,EAAG;MAChB,MAAMC,MAAK,GAAI,CAAC,CAAC;MACjB,IAAI,CAACL,QAAQ,CAACM,OAAO,CAACC,IAAG,IAAK;QAC1B,MAAMC,GAAE,GAAID,IAAI,CAACE,QAAQ;QACzB,IAAI,CAACJ,MAAM,CAACG,GAAG,CAAC,EAAEH,MAAM,CAACG,GAAG,IAAI,EAAE;QAClCH,MAAM,CAACG,GAAG,CAAC,CAACE,IAAI,CAACH,IAAI,CAAC;MAC1B,CAAC,CAAC;MACF,OAAOF,MAAM;IAEjB;EACJ,CAAC;EACDM,OAAO,EAAE;IACL,MAAMC,WAAWA,CAAA,EAAG;MAChB,MAAMC,KAAK,CAAC,gCAAgC,EACvCC,IAAI,CAAEC,GAAG,IAAKA,GAAG,CAACC,IA