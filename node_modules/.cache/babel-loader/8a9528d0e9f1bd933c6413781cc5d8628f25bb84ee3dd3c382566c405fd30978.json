ach(prod => {\n                const cat = prod.category || \"Other\"\n                if (!groups[cat]) groups[cat] = []\n                groups[cat].push(prod)\n            })\n\n            return groups\n        },\n        searchProducts() {\n            if (!this.searchQuery) return this.products\n\n            const query = this.searchQuery.toLowerCase()\n\n            return this.products.filter(prod =>\n                prod.title?.toLowerCase().includes(query)\n            )\n        }\n    },\n    async mounted() {\n        await this.$store.dispatch('getProducts')\n    }\n}\n</script>"],"mappings":";;;;AAmEA,OAAOA,WAAU,MAAO,+BAA+B;AACvD,eAAe;EACXC,UAAU,EAAE;IACRD;EACJ,CAAC;EACDE,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,WAAW,EAAE,EAAE;MACfC,KAAK,EAAE;IACX;EACJ,CAAC;EACDC,QAAQ,EAAE;IACNC,QAAQA,CAAA,EAAG;MACP,OAAO,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,QAAO;IACpC,CAAC;IACDG,iBAAiBA,CAAA,EAAG;MAChB,MAAMC,MAAK,GAAI,CAAC;MAEhB,IAAI,CAAC,IAAI,CAACC,cAAc,EAAE,OAAOD,MAAK;MAEtC,IAAI,CAACC,cAAc,CAACC,OAAO,CAACC,IAAG,IAAK;QAChC,MAAMC,GAAE,GAAID,IAAI,CAACE,QAAO,IAAK,OAAM;QACnC,IAAI,CAACL,MAAM,CAACI,GAAG,CAAC,EAAEJ,MAAM,CAACI,GAAG,IAAI,EAAC;QACjCJ,MAAM,CAACI,GAAG,CAAC,CAACE,IAAI,CAACH,IAAI;MACzB,CAAC;MAED,OAAOH,MAAK;IAChB,CAAC;IACDC,cAAcA,CAAA,EAAG;MACb,IAAI,CAAC,IAAI,CAACR,WAAW,EAAE,OAAO,IAAI,CAACG,QAAO;MAE1C,MAAMW,KAAI,GAAI,IAAI,CAACd,WAAW,CAACe,WAAW,CAAC;MAE3C,OAAO,IAAI,CAACZ,QAAQ,CAACa,MAAM,CAACN,IAAG,IAC3BA,IAAI,CAACO,KAAK,EAAEF,WAAW,CAAC,CAAC,CAACG,QAAQ,CAACJ,KAAK,CAC5C;IACJ;EACJ,CAAC;EACD,MAAMK,OAAOA,CAAA,EAAG;IACZ,MAAM,IAAI,CAACf,MAAM,CAACgB,QAAQ,CAAC,aAAa;EAC5C;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}